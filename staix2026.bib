@InProceedings{bose26,
  title = {{{VADR}: Variance Adjusted Distribution Regression}},
  author = {Bose, Soumyabrata},
  pages = {556--572},
  abstract = {Distribution regression predicts a scalar response from distribution-valued covariates, typically observed as grouped individual-level samples. Tree-based methods naturally capture sparse, low-order interactions in tabular data, but integrating decision trees against discrete empirical measures produces empty leaves and severe attenuation bias when the per-group sample sizes are small. We introduce Variance Adjusted Distribution Regression (VADR), which replaces the discrete empirical measure with a continuous, variance-regularised density estimator built from two steps: Gaussian smoothing of the axis-aligned tree leaves, followed by empirical Bayes shrinkage toward a global pooled estimate. The smoothed leaf masses are analytic and always positive, eliminating zero-inflation entirely, while the shrinkage borrows statistical strength across groups and stabilises the local variance. We prove that this dual-resolution estimator strictly dominates the standard empirical plugin in finite-sample mean squared error under a simple bias--variance condition, and that the resulting fractional posterior provides an explicit finite-risk guarantee even in the extreme sparse-bag regime with bounded per-group samples; in the dense regime it recovers the near-minimax rate for sparse additive regression. Experiments on synthetic data and a voting-behaviour application demonstrate the practical advantages of VADR.},
