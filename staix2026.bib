@InProceedings{tang26a,
  title = {{Bridging Data Gaps in Oncology: Integrating Large Language Models and Recommendation Systems for Evidence Synthesis}},
  author = {Tang, Tengjie and Li, Angkai and Bai, Xuanyu and Tan, Xingye and Ji, Qingli and Ulis, Michael and Si, Lu and Bao, Le},
