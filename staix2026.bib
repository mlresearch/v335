@InProceedings{gao26,
  title = {{{FACTOR}: Fairness-Aligned Conformal Transport for Optimal Regions}},
  author = {Gao, Chenyin and Han, Larry},
  pages = {113--126},
  abstract = {In high-stakes domains, decisions often hinge on jointly predicting multiple potentially correlated outcomes. Existing methods for multivariate outcomes impose restrictive geometric assumptions, perform poorly with mixed outcomes, and lack subgroup-conditional guarantees, leading to inflated prediction regions and coverage gaps. We propose \textsc{factor}, \emph{Fairness-Aligned Conformal Transport for Optimal Regions}, a framework for constructing compact and fair multivariate prediction regions. \textsc{factor} learns an optimal-transport map to a uniform latent distribution via normalizing flows with input-convex neural networks, inducing a scalar center-outward rank for multivariate outcomes. A post-hoc synchronization step aligns subgroup rank distributions while preserving within-group ordering and provides finite-sample control of empirical subgroup discrepancies. A rank-space band is then selected to reduce estimated average region volume within the candidate family, followed by split-conformal calibration to retain distribution-free marginal coverage. Empirically, on synthetic experiments and six real-world benchmarks, \textsc{factor} consistently achieves target coverage with reduced prediction region volume, minimal subgroup disparities, and competitive runtime relative to state-of-the-art baselines.},
  openreview = {aYlM08uR9J},
  software = {https://github.com/Gaochenyin/FACTOR}
}

