@InProceedings{zhai26,
  title = {{{DEP}-{GAP}: Depth effects correction and lithology type prediction for geophysical inversion data}},
  author = {Zhai, Yibo and Hou, Yujian and Song, Fangda},
  pages = {150--163},
  abstract = {Geophysical inversion is the mathematical process of predicting underground geophysical properties at different depths from wave signals detected on the ground, such as seismic waves. Three-dimensional reconstruction of lithology type based on geophysical inversion data enables determining the optimal drilling location and depth. However, the normalization procedures inherent in geophysical inversion often leads to substantial discrepancies between the inferred geophysical properties and those directly measured from drilled rock samples. As a result, geologists usually have to annotate inversion results manually based on expert knowledge. These discrepancies, which can vary with depth even for the same lithology type, will further hamper manual annotation. To address these challenges, we develop an unsupervised hierarchical Bayesian model to cluster different lithology types, correct the depth effects automatically, and finally recover the 3D geological structures from inversion data. Our model also incorporates spatial continuity of the lithology type distribution. We develop a Monte Carlo Markov Chain algorithm for posterior inference and validate our approach through extensive simulation studies. Finally, we predict the lithology type distribution of an oil base located in east-northern China, and the lithology type predictions based on the inversion data are highly consistent with that those obtained from drilling samples.},
  openreview = {2JAAtMdV3V},
  software = {https://github.com/BoboLearnGCN/DEP-GAP}
}

