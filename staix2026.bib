@InProceedings{yao26,
  title = {{Calibrated Cross-Modal Prediction of Single-Cell Transcriptomes from Histology Images}},
  author = {Yao, Jia and Zhou, Qin and Shi, Wenqi and Yang, Yuqiu and Buhaya, Munir and Jiang, Yi and Wang, Tao and Xie, Yang and Huang, Emina and Xiao, Guanghua},
  pages = {211--229},
  abstract = {Contrastive vision-language recipes optimise embedding geometry but produce no likelihood, while single-cell generative models fit a proper count likelihood but ignore the image. We argue the objective worth optimising is not raw point accuracy but a calibrated probabilistic transcript prediction usable for downstream biological inference. We present Image2Transcript, a single end-to-end model that couples a ViT-B/16 image encoder and a transformer gene encoder with a zero-inflated negative binomial (ZINB) head, trained under a joint contrastive, Smooth-L1 alignment, and ZINB-NLL negative-log-likelihood objective. On a 29- slide, 3.89M-cell Xenium cohort with a leakage-safe slide-group split, the model achieves per-cell Pearson 0.5368 on a frozen 640,928-cell test set (+0.087 over a matched frozen-ViT ridge baseline; within 0.017 of the strongest MSE variant, which is marginally better on point prediction but yields no likelihood), with calibrated per-gene zero-rates (r= 0.956, MAE 0.028) that no point regressor can produce. Swapping three pathology foundation encoders (Phikon2, Prov-GigaPath, UNI2-h) into the same ridge head reaches at most rcell = 0.497, identifying the multimodal objective, not the backbone, as the load-bearing factor. Without retraining, it transfers to TCGA-COAD H\&E and correlates with overall survival, vital status, and recurrence under a calibrated patient-shuffle null that correctly rejects gender as a negative control; on HEST-Bench, the same encoder leads on 4 of 5 cancer types (macro-average 0.400 vs. 0.269 for the second best baseline).},
  openreview = {LyfvLyj6PY},
  software = {https://github.com/yaober/image2transcripts}
}

