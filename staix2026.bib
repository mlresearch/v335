@InProceedings{wang26a,
  title = {{Gene Ontology {DAG}-Aware Conformal {FDR} Control for Multi-Label Protein Function Prediction: A Maize Application}},
  author = {Wang, Min and Wang, Chong and Liu, Peng},
  pages = {92--101},
  abstract = {Protein function prediction is a central task in biological research, where artificial intelligence (AI)-based tools are increasingly used for Gene Ontology (GO) annotation. However, AI predictions are usually reported without statistically interpretable uncertainty measures or error control, which limits the reliability of downstream annotation decisions, especially when predicted functions are used to prioritize proteins for biological follow-up. We develop a general calibration framework for multi-label GO predictors that combines protein-level conformal false discovery rate (FDR) control with GO directed acyclic graph (GO-DAG)-aware losses. The ontology-aware methods include GO-DAG true-path control, which propagates labels to valid ancestors, and GO-DAG near-1 and near-2 losses, which count predictions as acceptable when they are within one or two GO-DAG edges of an observed term. These methods can be applied to any model producing per-protein GO scores and convert those scores into prediction sets with controlled expected protein-level false discovery proportion (FDP). We apply the framework to maize functional annotation as an agricultural genomics example, using an Evolutionary Scale Modeling 2 (ESM-2)-based GO scoring model and comparing the results with a No-DAG direct baseline. In a held-out benchmark evaluation, incorporating GO-DAG structure increased the average number of proteins receiving conformal predictions from 137 under the No-DAG direct baseline to 236 under GO-DAG true-path control and to 314 under GO-DAG near-2 control, while maintaining low protein-level error under the corresponding exact or GO-DAG-aware loss. In a separate application to proteins without retained benchmark labels but with external Gene Ontology Annotation (GOA) evidence available for comparison, protein-wise GOA support increased from 34.3\% under the No-DAG direct baseline to 42.0\% under GO-DAG true-path control and 47.0\% under GO-DAG near-2 control. Although we focus on FDP/FDR, the same conformal structure can accommodate other protein-level losses on multi-label GO-DAG outputs. These results demonstrate that GO-DAG-aware conformal calibration can improve the biological utility of protein function predictions by increasing protein-wise GOA-supported discoveries while maintaining controlled protein-level error in benchmark evaluation.},
  openreview = {zhUfNvfEbO},
  software = {https://github.com/ChongWangStat/conformal-go-dag}
}

